; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Master of Defense"
run/main_scene="res://src/scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icons/icon_256.png"

[autoload]

GameData="*res://src/autoload/GameData.gd"
GameState="*res://src/autoload/GameState.gd"
Ticker="*res://src/autoload/Ticker.gd"
AudioManager="*res://src/autoload/AudioManager.gd"
SaveManager="*res://src/autoload/SaveManager.gd"
DisplayManager="*res://src/autoload/DisplayManager.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=4

[physics]

; Physics serves only the mouse picking (ray casts against static zones and the units'
; areas), so 30 Hz is plenty.
common/physics_ticks_per_second=30

[rendering]

; Phones run the Mobile (Vulkan) renderer. It has no depth pre-pass, so the alpha-textured
; brushes (menu sign, HUD sheets, road patches) get a second, alpha-scissored pass that writes
; the depth of their solid texels (b3d_post_import.gd, `solid_pass` as the material's
; next_pass) -- otherwise the sign posts sort over the planks.
; The emulator cannot present Vulkan; the "Android Emulator" export preset forces
; gl_compatibility, whose pre-pass stays on for mobile GPUs here.
renderer/rendering_method.mobile="mobile"
driver/depth_prepass/disable_for_vendors=""
textures/vram_compression/import_etc2_astc=true

[importer_defaults]

texture={
"mipmaps/generate": true,
"detect_3d/compress_to": 0
}
scene={
"_subresources": {
"nodes": {
"PATH:AnimationPlayer": {
"optimizer/enabled": false
}
}
},
"animation/fps": 1,
"import_script/path": "res://addons/b3d_import/b3d_post_import.gd",
"meshes/create_shadow_meshes": false,
"meshes/ensure_tangents": false,
"meshes/generate_lods": false
}
