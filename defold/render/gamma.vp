#version 140

// The full-screen quad of the gamma pass: builtins quad_2x2 (-1..1 in its XZ plane) taken
// straight as clip-space coordinates.
in highp vec4 position;

out mediump vec2 var_uv;

void main()
{
    vec2 p = vec2(position.x, -position.z);
    var_uv = p * 0.5 + 0.5;
    gl_Position = vec4(p, 0.0, 1.0);
}
