path_settings {
  path: "/assets/hud/**"
  profile: "Gui"
}
path_settings {
  path: "**/*.jpg"
  profile: "Opaque"
}
path_settings {
  path: "**"
  profile: "Default"
}
profiles {
  name: "Default"
  platforms {
    os: OS_ID_GENERIC
    formats {
      format: TEXTURE_FORMAT_RGBA
      compressor: "BasisU"
      compressor_preset: "BASISU_HIGH"
    }
    mipmaps: true
    premultiply_alpha: false
  }
}
profiles {
  name: "Opaque"
  platforms {
    os: OS_ID_GENERIC
    formats {
      format: TEXTURE_FORMAT_RGB
      compressor: "BasisU"
      compressor_preset: "BASISU_HIGH"
    }
    mipmaps: true
    premultiply_alpha: false
  }
}
profiles {
  name: "Gui"
  platforms {
    os: OS_ID_GENERIC
